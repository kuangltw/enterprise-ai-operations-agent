# 請複製為 .env；此檔僅供本機開發，禁止使用於正式環境
AGENT_DB_NAME=agent_ops
AGENT_DB_USER=agent_app
AGENT_DB_PASSWORD=change-agent-password
ERP_DB_NAME=demo_erp
ERP_DB_USER=erp_app
ERP_DB_PASSWORD=change-erp-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-password
# 需另行建立僅能存取私有 documents Bucket 的應用憑證；不得填入 Root 憑證
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
JWT_SIGNING_KEY=change-generate-a-random-key-of-at-least-32-bytes
